# Client-side (Vite)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Initial staff admin account configuration (JSON format)
# Example: [{"username":"admin","password_hash":"$2b$12$...","role":"admin","allowedRoutes":["/admin","/manager","/reviewer","/receiver"]}]
STAFF_USERS=[]

# Server-side (Express backend)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Cloud Storage Service Account (JSON string or Base64 in Cloud Run)
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-gcp-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
GCS_BUCKET=your-gcs-media-bucket

# Lark / Feishu Open Platform
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret

# Nhanh.vn API Configuration
NHANH_APP_ID=your_nhanh_app_id
NHANH_BUSINESS_ID=your_nhanh_business_id
NHANH_ACCESS_TOKEN=your_nhanh_access_token

NHANH_PRODUCT_APP_ID=your_nhanh_product_app_id
NHANH_PRODUCT_BUSINESS_ID=your_nhanh_product_business_id
NHANH_PRODUCT_ACCESS_TOKEN=your_nhanh_product_access_token

# Secret key for signing backend session JWTs (minimum 32 characters)
AUTH_JWT_SECRET=replace_this_with_a_secure_random_32_character_string
